    function saveBestScore(username, score) {
      if (!username) return 0;
      const currentBest = getBestScore(username);
      const nextBest = Math.max(currentBest, score);
      try {
        localStorage.setItem(LOCAL_KEYS.BEST_SCORE_PREFIX + username.toLowerCase(), String(nextBest));
      } catch (_) {}
      return nextBest;
    }

    /*************************************************************************
     * 5. STRICT MASTERED VOCABULARY FETCH & MULTIPLE-CHOICE GENERATION
     *************************************************************************/
    function normalizeText(str) {
      return typeof str === "string" ? str.trim() : "";
    }

    function normalizeKey(str) {
      return normalizeText(str).toLowerCase();
    }

    function isEligibleMasteredWord(rawDoc, expectedUsername) {
      if (!rawDoc || typeof rawDoc !== "object") return null;

      // 1. Strict username match
      const docUsername = normalizeText(rawDoc.username);
      if (!docUsername || docUsername !== expectedUsername) return null;

      // 2. Authoritative eligibility condition: memoryStatus === "mastered"
      // Never treat hasBeenStudied === true alone as proof of mastery.
      if (rawDoc.memoryStatus !== "mastered") return null;

      // 3. Valid English word
      const word = normalizeText(rawDoc.word);
      if (!word) return null;

      // 4. Valid Vietnamese meaning hint
      const meaning = normalizeText(rawDoc.meaning);
      if (!meaning) return null;

      // 5. At least one usable synonym in synonym1 or synonym2 (distinct from target word)
      const syn1 = normalizeText(rawDoc.synonym1);
      const syn2 = normalizeText(rawDoc.synonym2);
      const validSynonyms = [];

      if (syn1 && normalizeKey(syn1) !== normalizeKey(word)) {
        validSynonyms.push(syn1);
      }
      if (
        syn2 &&
        normalizeKey(syn2) !== normalizeKey(word) &&
        normalizeKey(syn2) !== normalizeKey(syn1)
      ) {
        validSynonyms.push(syn2);
      }

      if (validSynonyms.length === 0) return null;

      return {
        word,
        meaning,
        synonyms: validSynonyms
      };
    }

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    /**
     * Dynamically builds validated 4-option multiple choice questions from the
     * student's eligible mastered vocabulary.
     */
    function buildQuestionBank(eligibleWords) {
      // Deduplicate by target word key while merging known synonyms so we never
      // use a second valid synonym of the same word as a distractor.
      const wordMap = new Map();

      for (const item of eligibleWords) {
        const key = normalizeKey(item.word);
        if (!wordMap.has(key)) {
          wordMap.set(key, {
            word: item.word,
            meaning: item.meaning,
            synonyms: [...item.synonyms],
            forbiddenKeys: new Set([
              key,
              ...item.synonyms.map(normalizeKey)
            ])
          });
        } else {
          const existing = wordMap.get(key);
          for (const syn of item.synonyms) {
            const synKey = normalizeKey(syn);
            if (!existing.forbiddenKeys.has(synKey)) {
              existing.synonyms.push(syn);
              existing.forbiddenKeys.add(synKey);
            }
          }
        }
      }

      const uniqueEntries = Array.from(wordMap.values());

      // Collect all candidate distractor synonyms across the student's mastered pool
      const allPoolSynonyms = [];
      for (const entry of uniqueEntries) {
        for (const syn of entry.synonyms) {
          allPoolSynonyms.push({
            text: syn,
            key: normalizeKey(syn),
            sourceWordKey: normalizeKey(entry.word)
          });
        }
      }

      const questions = [];

      for (const entry of uniqueEntries) {
        // Select synonym1 or synonym2 at random when both are valid
        const chosenCorrect =
          entry.synonyms[Math.floor(Math.random() * entry.synonyms.length)];
        const chosenCorrectKey = normalizeKey(chosenCorrect);

        // Filter plausible distractors from other eligible mastered words:
        // - Must not match the target word
        // - Must not match ANY valid synonym of the target word
        // - Must be case-insensitively unique
        const distractorCandidates = [];
        const seenKeys = new Set(entry.forbiddenKeys);
        seenKeys.add(chosenCorrectKey);

        for (const candidate of shuffleArray(allPoolSynonyms)) {
          if (candidate.sourceWordKey === normalizeKey(entry.word)) continue;
          if (seenKeys.has(candidate.key)) continue;
          seenKeys.add(candidate.key);
          distractorCandidates.push(candidate.text);
          if (distractorCandidates.length === 3) break;
        }

        // Only include the question if 3 reliable, non-conflicting distractors exist
        if (distractorCandidates.length === 3) {
          const options = shuffleArray([chosenCorrect, ...distractorCandidates]);
          questions.push({
            word: entry.word,
            meaning: entry.meaning,
            correctAnswer: chosenCorrect,
            options
          });
        }
      }

      return shuffleArray(questions);
    }

    async function loadStudentVocabulary() {
      sound.playClick();
      const username = normalizeText(dom.usernameInput.value);
      dom.btnStartGame.disabled = true;

      if (!username) {
        setVocabStatus("Please enter your LexicalSpace username before loading vocabulary.", "error");
        return;
      }

      if (!navigator.onLine) {
        setVocabStatus("You appear to be offline. Please check your internet connection and retry.", "error");
        return;
      }

      const fbStatus = ensureFirebaseInitialized();
      if (!fbStatus.ok) {
        setVocabStatus(`Firebase initialization error: ${fbStatus.reason}`, "error");
        return;
      }

      // Show loading spinner
      dom.vocabStatusBox.className = "status-box";
      dom.vocabStatusBox.innerHTML = `<div class="revolver-spinner"></div><div>Loading mastered vocabulary for <strong>${escapeHtml(username)}</strong>...</div>`;
      dom.btnLoadVocab.disabled = true;

      try {
        // Query Firestore words collection for this student's mastered words
        const snapshot = await state.db
          .collection(LEXICALSPACE_CONFIG.wordsCollection)
          .where("username", "==", username)
          .where("memoryStatus", "==", "mastered")
          .get();

        const eligible = [];
        snapshot.forEach((docSnap) => {
          const validated = isEligibleMasteredWord(docSnap.data(), username);
          if (validated) eligible.push(validated);
        });

        state.activeUsername = username;
        state.eligibleWords = eligible;
        persistUsernameToStorage(username);
        dom.hudUsername.textContent = username;

        if (eligible.length === 0) {
          setVocabStatus(
            "You don't have any mastered vocabulary available for Quick Drawn yet. Learn and master some words in LexicalSpace first.",
            "error"
          );
          dom.btnLoadVocab.textContent = "Retry / Refresh Vocabulary";
          dom.btnLoadVocab.disabled = false;
          return;
        }

        state.questionBank = buildQuestionBank(eligible);

        if (state.questionBank.length === 0) {
          setVocabStatus(
            `Found ${eligible.length} mastered word(s), but at least 4 mastered words with distinct synonyms are required to build reliable 4-option questions without inventing fallback words. Master a few more words in LexicalSpace and refresh!`,
            "error"
          );
          dom.btnLoadVocab.textContent = "Refresh Vocabulary";
          dom.btnLoadVocab.disabled = false;
          return;
        }

        setVocabStatus(
          `Loaded ${eligible.length} mastered word(s) (${state.questionBank.length} duel question(s) ready) for "${username}". Best Score: ${getBestScore(username)}.`,
          "success"
        );
        dom.btnLoadVocab.textContent = "Refresh Vocabulary";
        dom.btnLoadVocab.disabled = false;
        dom.btnStartGame.disabled = false;
      } catch (err) {
        dom.btnLoadVocab.textContent = "Retry";
        dom.btnLoadVocab.disabled = false;

        const code = err && err.code ? String(err.code) : "";
        if (code === "permission-denied" || (err.message && err.message.toLowerCase().includes("permission"))) {
          setVocabStatus(
            "Firestore denied access (permission-denied). Verify that your LexicalSpace session is active or check your Firestore Security Rules.",
            "error"
          );
        } else if (code === "unavailable" || !navigator.onLine) {
          setVocabStatus(
            "Network error while contacting Firestore. Please check your connection and tap Retry.",
            "error"
          );
        } else {
          setVocabStatus(
            `Could not load vocabulary from Firestore: ${err.message || "Unknown error"}`,
            "error"
          );
        }
      }
    }

    function setVocabStatus(message, type = "") {
      dom.vocabStatusBox.className = "status-box" + (type ? ` ${type}` : "");
      dom.vocabStatusBox.textContent = message;
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (ch) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }[ch]));
    }

    /*************************************************************************
     * 6. EXACT GAME RULES, COUNTDOWN ENGINE & DUEL ANIMATIONS
     *************************************************************************/
    /**
     * Exact formula required by specification:
     * timeLimit = Math.max(1, 10 - (questionNumber - 1) * 0.5)
     */
    function calculateQuestionTimeLimit(questionNumber) {
      return Math.max(1, 10 - (questionNumber - 1) * 0.5);
    }

    function stopCountdownTimer() {
      if (state.rafId !== null) {
        cancelAnimationFrame(state.rafId);
        state.rafId = null;
      }
    }

    function startNewRun() {
      sound.playClick();
      if (!state.activeUsername || state.eligibleWords.length === 0) return;

      // Rebuild & shuffle question bank from the loaded mastered vocabulary for this run
      state.currentRunQuestions = buildQuestionBank(state.eligibleWords);
      if (state.currentRunQuestions.length === 0) {
        setVocabStatus("No valid questions could be generated. Please refresh vocabulary.", "error");
        return;
      }

      stopCountdownTimer();
      state.score = 0;
      state.questionNumber = 0;
      state.attemptedCount = 0;
      state.correctCount = 0;
      state.isRunActive = true;
      state.isQuestionLocked = true;

      dom.hudScore.textContent = "0";
      dom.hudUsername.textContent = state.activeUsername;

      dom.titleScreen.classList.add("hidden");
      dom.resultScreen.classList.add("hidden");

      presentNextQuestion();
    }

    function presentNextQuestion() {
      stopCountdownTimer();

      // Check if the player answered every available mastered word without a mistake!
      if (state.questionNumber >= state.currentRunQuestions.length) {
        endRun(true, "All mastered vocabulary words conquered without a single miss!");
        return;
      }

      state.questionNumber += 1;
      const currentQ = state.currentRunQuestions[state.questionNumber - 1];
      state.timeLimitSec = calculateQuestionTimeLimit(state.questionNumber);

      // Reset cowboy duel stage to Idle Standoff (Reference Image 3)
      dom.duelStage.className = "duel-stage state-idle";
      dom.feedbackBanner.className = "feedback-banner";

      // Populate target word and Vietnamese meaning hint
      dom.targetWordText.textContent = currentQ.word;
      dom.targetMeaningText.textContent = `(${currentQ.meaning})`;

      // Populate and unlock 4 answer buttons
      dom.answerButtons.forEach((btn, idx) => {
        btn.className = "answer-btn";
        btn.disabled = false;
        btn.textContent = currentQ.options[idx];
      });

      // Reset fuse countdown visuals
      updateTimerVisuals(state.timeLimitSec, state.timeLimitSec);

      state.isQuestionLocked = false;
      state.questionStartTime = performance.now();

      const tick = (now) => {
        if (!state.isRunActive || state.isQuestionLocked) return;

        const elapsedSec = (now - state.questionStartTime) / 1000;
        const remainingSec = Math.max(0, state.timeLimitSec - elapsedSec);

        updateTimerVisuals(remainingSec, state.timeLimitSec);

        if (remainingSec <= 0) {
          handleTimeout();
          return;
        }

        state.rafId = requestAnimationFrame(tick);
      };

      state.rafId = requestAnimationFrame(tick);
    }

    function updateTimerVisuals(remainingSec, totalSec) {
      const clampedRemaining = Math.max(0, remainingSec);
      const ratio = totalSec > 0 ? Math.max(0, Math.min(1, clampedRemaining / totalSec)) : 0;
      const percent = ratio * 100;

      dom.hudTimerText.textContent = `Q${state.questionNumber} • ${clampedRemaining.toFixed(1)}s`;
      dom.fuseFill.style.width = `${percent}%`;
      dom.fuseSpark.style.left = `${percent}%`;

      // Urgent visual state when <= 3 seconds remain
      const isUrgent = clampedRemaining <= 3.0;
      dom.hudTimerText.classList.toggle("urgent", isUrgent);
      dom.fuseFill.classList.toggle("urgent", isUrgent);

      if (isUrgent && dom.duelStage.classList.contains("state-idle")) {
        dom.duelStage.classList.add("state-urgent");
      } else {
        dom.duelStage.classList.remove("state-urgent");
      }
    }

    function lockAllAnswerButtons() {
      state.isQuestionLocked = true;
      stopCountdownTimer();
      dom.answerButtons.forEach((btn) => {
        btn.disabled = true;
      });
    }

    function showBannerFeedback(text, isHit) {
      dom.feedbackBanner.textContent = text;
      dom.feedbackBanner.className = `feedback-banner show ${isHit ? "hit" : "miss"}`;
    }

    function handleAnswerSelection(selectedIndex) {
      // Strictly ignore clicks if locked, animation running, or run already ended
      if (!state.isRunActive || state.isQuestionLocked) return;

      const now = performance.now();
      const elapsedSec = (now - state.questionStartTime) / 1000;
      if (elapsedSec >= state.timeLimitSec) {
        // Late click after timer expiration must never count
        handleTimeout();
        return;
      }

      lockAllAnswerButtons();

      const currentQ = state.currentRunQuestions[state.questionNumber - 1];
      const chosenOption = currentQ.options[selectedIndex];
      const isCorrect = normalizeKey(chosenOption) === normalizeKey(currentQ.correctAnswer);

      state.attemptedCount += 1;

      if (isCorrect) {
        // +1 point, no deduction ever
        state.score += 1;
        state.correctCount += 1;
        dom.hudScore.textContent = String(state.score);

        dom.answerButtons[selectedIndex].classList.add("correct");
        // Trigger Player Shooting AI Cowboy animation (Reference Image 2)
        dom.duelStage.className = "duel-stage state-player-win";
        showBannerFeedback("BULLSEYE! +1", true);
        sound.playGunshot(true);

        setTimeout(() => {
          if (!state.isRunActive) return;
          presentNextQuestion();
        }, 780);
      } else {
        // Wrong answer: 0 points deducted, highlight chosen wrong + actual correct answer, end run
        dom.answerButtons[selectedIndex].classList.add("wrong");
        dom.answerButtons.forEach((btn, idx) => {
          if (normalizeKey(currentQ.options[idx]) === normalizeKey(currentQ.correctAnswer)) {
            btn.classList.add("correct");
          }
        });

        // Trigger AI Opponent Shooting Player animation (Reference Image 1)
        dom.duelStage.className = "duel-stage state-enemy-win";
        showBannerFeedback("MISSED SHOT!", false);
        sound.playScream();

        setTimeout(() => {
          endRun(
            false,
            `Wrong synonym for "${currentQ.word}". The correct synonym was "${currentQ.correctAnswer}".`
          );
        }, 1150);
      }
    }

    function handleTimeout() {
      if (!state.isRunActive || state.isQuestionLocked) return;
      lockAllAnswerButtons();
      updateTimerVisuals(0, state.timeLimitSec);

      state.attemptedCount += 1;
      const currentQ = state.currentRunQuestions[state.questionNumber - 1];

      // Reveal correct synonym
      dom.answerButtons.forEach((btn, idx) => {
        if (normalizeKey(currentQ.options[idx]) === normalizeKey(currentQ.correctAnswer)) {
          btn.classList.add("correct");
        }
      });

      // Trigger AI Opponent Shooting Player animation (Reference Image 1)
      dom.duelStage.className = "duel-stage state-enemy-win";
      showBannerFeedback("TOO SLOW!", false);
      sound.playScream();

      setTimeout(() => {
        endRun(
          false,
          `Out of time on "${currentQ.word}"! The correct synonym was "${currentQ.correctAnswer}".`
        );
      }, 1150);
    }

    function endRun(isFullVictory, detailMessage) {
      stopCountdownTimer();
      state.isRunActive = false;
      state.isQuestionLocked = true;

      const bestScore = saveBestScore(state.activeUsername, state.score);
      const accuracy =
        state.attemptedCount > 0
          ? Math.round((state.correctCount / state.attemptedCount) * 100)
          : 0;

      if (isFullVictory) {
        dom.resultTitleBadge.textContent = "SHERIFF VICTORY!";
        dom.resultSubtitle.textContent = "Every Mastered Word Flawlessly Drawn!";
        sound.playVictoryFanfare();
      } else {
        dom.resultTitleBadge.textContent = "DUEL OVER";
        dom.resultSubtitle.textContent = "Outdrawn in the Canyon!";
      }

      dom.statFinalScore.textContent = String(state.score);
      dom.statBestScore.textContent = String(bestScore);
      dom.statAttempted.textContent = String(state.attemptedCount);
      dom.statCorrect.textContent = String(state.correctCount);
      dom.statAccuracy.textContent = `${accuracy}%`;
      dom.resultDetailBox.textContent = detailMessage;

      dom.resultScreen.classList.remove("hidden");
    }

    /*************************************************************************
     * 7. EVENT LISTENERS & INITIALIZATION
     *************************************************************************/
    dom.answerButtons.forEach((btn, idx) => {
      btn.addEventListener("click", () => handleAnswerSelection(idx));
    });

    dom.btnAudioToggle.addEventListener("click", () => {
      const muted = sound.toggleMute();
      dom.btnAudioToggle.classList.toggle("muted", muted);
      dom.svgSpeakerOn.style.display = muted ? "none" : "block";
      dom.svgSpeakerOff.style.display = muted ? "block" : "none";
      if (!muted) sound.playClick();
    });

    dom.btnLoadVocab.addEventListener("click", () => {
      loadStudentVocabulary();
    });

    dom.usernameInput.addEventListener("input", () => {
      const entered = normalizeText(dom.usernameInput.value);
      if (entered !== state.activeUsername) {
        dom.btnStartGame.disabled = true;
        setVocabStatus("Username changed. Tap 'Refresh Vocabulary' to load this student's mastered words.");
      }
    });

    dom.usernameInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        loadStudentVocabulary();
      }
    });

    dom.btnStartGame.addEventListener("click", () => {
      startNewRun();
    });

    dom.btnPlayAgain.addEventListener("click", () => {
      startNewRun();
    });

    dom.btnReturnTitle.addEventListener("click", () => {
      sound.playClick();
      stopCountdownTimer();
      state.isRunActive = false;
      dom.resultScreen.classList.add("hidden");
      dom.titleScreen.classList.remove("hidden");
      if (state.activeUsername) {
        setVocabStatus(
          `Ready for "${state.activeUsername}". Best Score: ${getBestScore(state.activeUsername)}. (${state.questionBank.length} duel questions available)`,
          "success"
        );
      }
    });

    // Boot Sequence on Page Load
    window.addEventListener("DOMContentLoaded", () => {
      const storedUser = detectStoredUsername();
      if (storedUser) {
        dom.usernameInput.value = storedUser;
        dom.hudUsername.textContent = storedUser;
      }

      const fbStatus = ensureFirebaseInitialized();
      if (fbStatus.ok && storedUser) {
        loadStudentVocabulary();
      } else if (!fbStatus.ok) {
        setVocabStatus(`Firebase initialization error: ${fbStatus.reason}`, "error");
      }
    });
  </script>
</body>
</html>
