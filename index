<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>QUICK DRAWN — LexicalSpace Western Vocabulary Duel</title>
  <!-- Google Fonts for Retro Pixel & Western Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Chakra+Petch:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-outer: #2b1810;
      --card-cream: #f8edd6;
      --card-border-orange: #ee821a;
      --wood-dark: #4f2711;
      --wood-mid: #7d4218;
      --wood-light: #9e5824;
      --word-blue-bg: #99ccff;
      --word-blue-border: #0e63c6;
      --word-blue-highlight: #bbe0ff;
      --word-navy-text: #112277;
      --meaning-blue-text: #3863a8;
      --btn-gold-bg: #fae078;
      --btn-gold-border: #c56212;
      --btn-gold-shadow: #9b4508;
      --btn-gold-highlight: #fff3b8;
      --btn-text-dark: #381808;
      --danger-red: #d32f2f;
      --success-green: #2e7d32;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      height: 100dvh;
      overflow: hidden;
      background: radial-gradient(circle at center, #3d2214 0%, #1c0f08 100%);
      font-family: 'Chakra Petch', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--btn-text-dark);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Main Mobile-First Portrait Frame */
    .game-shell {
      position: relative;
      width: 100%;
      max-width: 430px;
      height: 100%;
      height: 100dvh;
      max-height: 880px;
      padding: calc(8px + var(--safe-top)) 10px calc(8px + var(--safe-bottom)) 10px;
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 460px) {
      .game-shell {
        height: 94dvh;
        padding: 12px;
      }
    }

    .arcade-card {
      position: relative;
      width: 100%;
      height: 100%;
      background-color: var(--card-cream);
      border: 5px solid var(--card-border-orange);
      border-radius: 26px;
      box-shadow:
        0 14px 36px rgba(0, 0, 0, 0.65),
        inset 0 0 0 3px #fdf6e9;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    /* Top HUD Bar */
    .top-hud {
      position: relative;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px 4px 14px;
      gap: 8px;
      flex-shrink: 0;
    }

    /* Wooden Score Plaque with Red Poker/Bounty Chip */
    .wood-score-board {
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(180deg, #8c4b1e 0%, #6d3712 55%, #55280b 100%);
      border: 3px solid #351605;
      border-radius: 8px;
      padding: 4px 16px 4px 10px;
      min-width: 118px;
      box-shadow:
        inset 0 2px 0 rgba(255, 210, 155, 0.35),
        inset 0 -3px 0 rgba(0, 0, 0, 0.35),
        0 3px 0 rgba(0, 0, 0, 0.2);
    }

    .bounty-chip {
      width: 34px;
      height: 34px;
      flex-shrink: 0;
      filter: drop-shadow(0 2px 0 #2b1104);
    }

    .score-value {
      font-family: 'Press Start 2P', monospace;
      font-size: 1.2rem;
      color: #ffffff;
      text-shadow:
        2px 2px 0 #2b1104,
        -1px -1px 0 #2b1104,
        1px -1px 0 #2b1104,
        -1px 1px 0 #2b1104;
      letter-spacing: 1px;
    }

    /* Center Status Pill (Username + Question Counter + Time) */
    .hud-meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      min-width: 0;
    }

    .hud-username {
      font-size: 0.72rem;
      font-weight: 800;
      color: #6b3a18;
      background: rgba(238, 130, 26, 0.16);
      border: 1px solid rgba(197, 98, 18, 0.4);
      padding: 2px 8px;
      border-radius: 999px;
      max-width: 100%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hud-q-timer {
      font-family: 'Press Start 2P', monospace;
      font-size: 0.62rem;
      color: #5b2c0e;
      margin-top: 4px;
      letter-spacing: 0.5px;
    }

    .hud-q-timer.urgent {
      color: var(--danger-red);
      animation: pulseUrgent 0.35s infinite alternate;
    }

    @keyframes pulseUrgent {
      from { transform: scale(1); }
      to { transform: scale(1.08); }
    }

    /* Audio & Settings Buttons */
    .hud-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pixel-icon-btn {
      width: 40px;
      height: 40px;
      background: #f5d896;
      border: 3px solid #47210a;
      border-radius: 8px;
      box-shadow:
        inset 0 2px 0 #fff4d2,
        inset 0 -3px 0 #c99a49,
        0 2px 0 rgba(0,0,0,0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.08s ease;
    }

    .pixel-icon-btn:active {
      transform: translateY(2px);
    }

    .pixel-icon-btn.muted {
      background: #e0c79b;
      opacity: 0.75;
    }

    /* Duel Arena Illustration Area */
    .duel-stage-wrapper {
      position: relative;
      width: 100%;
      padding: 0 10px;
      flex-shrink: 0;
    }

    .duel-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 7.8;
      max-height: 175px;
      border-radius: 12px;
      overflow: hidden;
    }

    .duel-svg {
      width: 100%;
      height: 100%;
      display: block;
      image-rendering: pixelated;
    }

    /* Cowboy Animation States */
    .cowboy-player,
    .cowboy-enemy {
      transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
      transform-origin: center bottom;
    }

    .duel-stage.state-idle .cowboy-player,
    .duel-stage.state-idle .cowboy-enemy {
      animation: cowboyBreathe 1.4s ease-in-out infinite alternate;
    }

    .duel-stage.state-urgent .cowboy-enemy {
      animation: cowboyTwitch 0.25s ease-in-out infinite alternate;
    }

    @keyframes cowboyBreathe {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-2px); }
    }

    @keyframes cowboyTwitch {
      0% { transform: translateX(0px) rotate(0deg); }
      100% { transform: translateX(-2px) rotate(-1.5deg); }
    }

    /* Visibility of pose layers */
    .pose-hit,
    .muzzle-flash,
    .flying-gun,
    .shock-marks {
      opacity: 0;
      pointer-events: none;
    }

    /* Player shoots Enemy (Correct Answer) */
    .duel-stage.state-player-win .enemy-pose-idle {
      opacity: 0;
    }
    .duel-stage.state-player-win .enemy-pose-hit,
    .duel-stage.state-player-win .player-muzzle,
    .duel-stage.state-player-win .enemy-flying-gun,
    .duel-stage.state-player-win .enemy-shock {
      opacity: 1;
    }
    .duel-stage.state-player-win .enemy-pose-hit {
      animation: knockbackRight 0.45s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }
    .duel-stage.state-player-win .enemy-flying-gun {
      animation: gunSpinLeft 0.5s ease-out forwards;
    }

    /* Enemy shoots Player (Wrong Answer or Timeout) */
    .duel-stage.state-enemy-win .player-pose-idle {
      opacity: 0;
    }
    .duel-stage.state-enemy-win .player-pose-hit,
    .duel-stage.state-enemy-win .enemy-muzzle,
    .duel-stage.state-enemy-win .player-flying-gun,
    .duel-stage.state-enemy-win .player-shock {
      opacity: 1;
    }
    .duel-stage.state-enemy-win .player-pose-hit {
      animation: knockbackLeft 0.45s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }
    .duel-stage.state-enemy-win .player-flying-gun {
      animation: gunSpinRight 0.5s ease-out forwards;
    }

    @keyframes knockbackRight {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(12px, -10px) rotate(14deg); }
    }

    @keyframes knockbackLeft {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(-12px, -10px) rotate(-14deg); }
    }

    @keyframes gunSpinLeft {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(-18px, -16px) rotate(-38deg); }
    }

    @keyframes gunSpinRight {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(18px, -16px) rotate(38deg); }
    }

    /* Burning Fuse Timer Bar */
    .fuse-bar-container {
      position: relative;
      width: 86%;
      margin: 2px auto 6px auto;
      height: 26px;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .fuse-track {
      position: relative;
      width: 100%;
      height: 16px;
      background: repeating-linear-gradient(
        90deg,
        #3d1c0a 0px,
        #3d1c0a 6px,
        #522710 6px,
        #522710 12px
      );
      border: 3px solid #2b1104;
      border-radius: 9px;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.75), 0 1px 0 #f7d794;
      overflow: hidden;
    }

    .fuse-fill {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 100%;
      background: repeating-linear-gradient(
        90deg,
        #ff9914 0px,
        #ffd042 6px,
        #e04f00 12px
      );
      border-radius: 6px;
      transition: background 0.2s ease;
    }

    .fuse-fill.urgent {
      background: repeating-linear-gradient(
        90deg,
        #ff2a00 0px,
        #ffae00 6px,
        #b80000 12px
      );
    }

    /* Tied Fuse End Knot on Right */
    .fuse-knot {
      width: 18px;
      height: 16px;
      margin-left: -2px;
      flex-shrink: 0;
    }

    /* Burning Spark on the Moving Fuse Tip */
    .fuse-spark {
      position: absolute;
      top: 50%;
      left: 100%;
      width: 34px;
      height: 34px;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 4;
      animation: sparkFlicker 0.12s infinite alternate;
    }

    @keyframes sparkFlicker {
      0% { transform: translate(-50%, -50%) scale(0.92) rotate(-8deg); }
      100% { transform: translate(-50%, -50%) scale(1.12) rotate(8deg); }
    }

    /* Sky-Blue Pixel Vocabulary Card */
    .word-card-wrap {
      padding: 2px 16px;
      flex-shrink: 0;
    }

    .word-card {
      position: relative;
      background: var(--word-blue-bg);
      border: 4px solid var(--word-blue-border);
      border-radius: 16px;
      padding: 14px 14px 12px 14px;
      text-align: center;
      box-shadow:
        inset 0 4px 0 var(--word-blue-highlight),
        inset 0 -4px 0 #79b4f2,
        0 4px 0 rgba(14, 99, 198, 0.22);
      min-height: 98px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    /* Corner Pixel Accents */
    .word-card::before,
    .word-card::after {
      content: "";
      position: absolute;
      width: 12px;
      height: 12px;
      border-color: #5ca2eb;
      border-style: solid;
      pointer-events: none;
    }
    .word-card::before {
      top: 7px;
      left: 7px;
      border-width: 3px 0 0 3px;
    }
    .word-card::after {
      bottom: 7px;
      right: 7px;
      border-width: 0 3px 3px 0;
    }

    .target-word {
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 800;
      font-size: clamp(1.6rem, 6.5vw, 2.25rem);
      color: var(--word-navy-text);
      line-height: 1.1;
      letter-spacing: 0.5px;
      word-break: break-word;
      text-shadow: 0 2px 0 rgba(255, 255, 255, 0.45);
    }

    .target-meaning {
      margin-top: 5px;
      font-size: clamp(0.95rem, 3.8vw, 1.18rem);
      font-weight: 700;
      color: var(--meaning-blue-text);
      line-height: 1.25;
    }

    /* 2x2 Answer Options Grid */
    .answers-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      padding: 8px 16px;
      flex: 1;
      align-content: center;
      z-index: 5;
    }

    @media (max-width: 335px) {
      .answers-grid {
        grid-template-columns: 1fr;
        gap: 8px;
      }
    }

    .answer-btn {
      position: relative;
      min-height: 64px;
      padding: 10px 10px;
      background: var(--btn-gold-bg);
      border: 4px solid var(--btn-gold-border);
      border-radius: 14px;
      box-shadow:
        inset 0 4px 0 var(--btn-gold-highlight),
        inset 0 -4px 0 #e6be4c,
        0 4px 0 var(--btn-gold-shadow);
      font-family: 'Chakra Petch', sans-serif;
      font-size: clamp(1.05rem, 4.3vw, 1.32rem);
      font-weight: 800;
      color: var(--btn-text-dark);
      text-align: center;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      word-break: break-word;
      line-height: 1.15;
      transition: transform 0.08s ease, background-color 0.15s ease, border-color 0.15s ease;
    }

    .answer-btn:hover:not(:disabled) {
      background: #ffea8c;
    }

    .answer-btn:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow:
        inset 0 2px 0 var(--btn-gold-highlight),
        0 1px 0 var(--btn-gold-shadow);
    }

    .answer-btn:disabled {
      cursor: default;
    }

    .answer-btn.correct {
      background: #81c784 !important;
      border-color: #1b5e20 !important;
      color: #0d3311 !important;
      box-shadow:
        inset 0 4px 0 #b9f6ca,
        0 4px 0 #1b5e20 !important;
    }

    .answer-btn.wrong {
      background: #ef9a9a !important;
      border-color: #b71c1c !important;
      color: #5f0909 !important;
      box-shadow:
        inset 0 4px 0 #ffcdd2,
        0 4px 0 #7f0000 !important;
    }

    /* Bottom Desert Horizon Banner */
    .desert-footer {
      width: 100%;
      height: 68px;
      flex-shrink: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .desert-footer svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Overlay Screens (Title / Username / Loading / Error / Game Over / Victory) */
    .overlay-screen {
      position: absolute;
      inset: 0;
      z-index: 20;
      background: rgba(248, 237, 214, 0.97);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 18px 18px 14px 18px;
      text-align: center;
      overflow-y: auto;
    }

    .overlay-screen.hidden {
      display: none !important;
    }

    .wanted-poster {
      width: 100%;
      background: #f3dfb9;
      border: 4px solid #7d4218;
      border-radius: 16px;
      padding: 16px 14px;
      box-shadow:
        inset 0 0 0 2px #d9b882,
        0 6px 0 rgba(79, 39, 17, 0.22);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: auto 0;
    }

    .game-logo-badge {
      background: linear-gradient(180deg, #8c4b1e 0%, #55280b 100%);
      border: 3px solid #2b1104;
      border-radius: 12px;
      padding: 10px 16px;
      color: #ffd56b;
      font-family: 'Press Start 2P', monospace;
      font-size: clamp(1.05rem, 4.5vw, 1.35rem);
      text-shadow: 2px 2px 0 #2b1104;
      letter-spacing: 1px;
      box-shadow: 0 4px 0 #2b1104;
    }

    .subtitle-banner {
      font-size: 0.85rem;
      font-weight: 800;
      color: #6d3712;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .field-group {
      width: 100%;
      text-align: left;
      margin-top: 4px;
    }

    .field-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 800;
      color: #5b2c0e;
      margin-bottom: 4px;
      text-transform: uppercase;
    }

    .western-input {
      width: 100%;
      padding: 11px 12px;
      font-family: 'Chakra Petch', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: #2b1104;
      background: #fff9eb;
      border: 3px solid #8c4b1e;
      border-radius: 10px;
      outline: none;
      user-select: text;
      -webkit-user-select: text;
    }

    .western-input:focus {
      border-color: var(--word-blue-border);
      box-shadow: 0 0 0 3px rgba(14, 99, 198, 0.2);
    }

    .status-box {
      width: 100%;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      line-height: 1.35;
      background: #e9d2a6;
      border: 2px solid #9e6b3b;
      color: #4a250d;
    }

    .status-box.error {
      background: #ffebee;
      border-color: #c62828;
      color: #8e0000;
    }

    .status-box.success {
      background: #e8f5e9;
      border-color: #2e7d32;
      color: #1b5e20;
    }

    .security-note {
      font-size: 0.72rem;
      color: #6e4726;
      line-height: 1.3;
      background: rgba(140, 75, 30, 0.1);
      padding: 7px 9px;
      border-radius: 8px;
      border: 1px dashed #8c4b1e;
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      width: 100%;
      justify-content: center;
      margin-top: 4px;
    }

    .western-btn {
      flex: 1;
      min-width: 125px;
      min-height: 48px;
      padding: 10px 14px;
      font-family: 'Chakra Petch', sans-serif;
      font-size: 1rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #2b1104;
      background: var(--btn-gold-bg);
      border: 3px solid var(--btn-gold-border);
      border-radius: 12px;
      box-shadow:
        inset 0 3px 0 var(--btn-gold-highlight),
        0 4px 0 var(--btn-gold-shadow);
      cursor: pointer;
      transition: transform 0.08s ease, opacity 0.15s ease;
    }

    .western-btn.primary {
      background: #ff9800;
      border-color: #6d3712;
      color: #2b1104;
      box-shadow:
        inset 0 3px 0 #ffe082,
        0 4px 0 #4f2711;
    }

    .western-btn.secondary {
      background: #e6ccb2;
      border-color: #6d3712;
      box-shadow:
        inset 0 3px 0 #fff3e0,
        0 4px 0 #4f2711;
    }

    .western-btn:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #4f2711;
    }

    .western-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Stats Grid on Game Over / Victory */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      width: 100%;
      margin: 4px 0;
    }

    .stat-tile {
      background: #fff6e0;
      border: 2px solid #9e5824;
      border-radius: 10px;
      padding: 8px 6px;
    }

    .stat-label {
      font-size: 0.7rem;
      font-weight: 800;
      color: #7d4218;
      text-transform: uppercase;
    }

    .stat-num {
      font-family: 'Press Start 2P', monospace;
      font-size: 1rem;
      color: #2b1104;
      margin-top: 5px;
    }

    /* Loading Spinner */
    .revolver-spinner {
      display: inline-block;
      width: 28px;
      height: 28px;
      border: 4px solid #c56212;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      margin-bottom: 4px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Round Feedback Toast Banner */
    .feedback-banner {
      position: absolute;
      top: 58px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 15;
      padding: 6px 14px;
      border-radius: 999px;
      font-family: 'Press Start 2P', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.5px;
      border: 3px solid #2b1104;
      box-shadow: 0 4px 0 rgba(0,0,0,0.25);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    .feedback-banner.show {
      opacity: 1;
    }

    .feedback-banner.hit {
      background: #81c784;
      color: #0d3311;
    }

    .feedback-banner.miss {
      background: #ef5350;
      color: #ffffff;
    }
  </style>
</head>
<body>
  <main class="game-shell">
    <div class="arcade-card">

      <!-- TOP HUD: Wooden Score Plaque + Username/Timer + Audio Toggle -->
      <header class="top-hud">
        <div class="wood-score-board" aria-label="Current Score">
          <!-- Red Poker/Bounty Star Chip matching reference images -->
          <svg class="bounty-chip" viewBox="0 0 36 36" aria-hidden="true">
            <ellipse cx="18" cy="20" rx="15" ry="14" fill="#6e0e0e"/>
